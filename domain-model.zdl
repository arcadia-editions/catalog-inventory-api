config {
    id "urn:com.arcadiaeditions:catalog:inventory"
    version "0.1.0"
    title "Arcadia Editions - Catalog Inventory"
    basePackage "com.arcadiaeditions.catalog.inventory"
    persistence jpa

    plugins {
        /** Generates an AsyncAPI v3 specification from this ZDL model. */
        ZDLToAsyncAPIPlugin {
            id "urn:com.arcadiaeditions:catalog:inventory:asyncapi"
            applicationExtensions """
            x-application-bindings:
              x-principal: catalog_inventory
              x-clientId: catalog_inventory
              x-groupId: catalog_inventory
            """
            schemaFormat avro
            idType integer
            idTypeFormat int64
            avroPackage com.arcadiaeditions.catalog.inventory.events.avro
            includeCloudEventsHeaders true
            includeKafkaCommonHeaders true
            asyncapiOverlayFiles "https://raw.githubusercontent.com/arcadia-editions/api-contract-commons/refs/heads/main/asyncapi-overlay.yml"
            targetFile "./asyncapi.yml"
        }
        ZDLToAsyncAPIClientPlugin {
            id "urn:com.arcadiaeditions:catalog:inventory:asyncapi:client"
            applicationExtensions """
            x-application-bindings:
              x-principal: catalog_inventory
              x-clientId: catalog_inventory
              x-groupId: catalog_inventory
            """
            title "Arcadia Editions - Catalog Inventory - AsyncAPI Client"
            asyncapiOverlayFiles "https://raw.githubusercontent.com/arcadia-editions/api-contract-commons/refs/heads/main/asyncapi-client-overlay.yml"
            targetFile "./asyncapi-client.yml"
        }
        /** Generates an OpenAPI 3.0 specification from this ZDL model. */
        ZDLToOpenAPIPlugin {
            idType integer
            idTypeFormat int64
            targetFile "./openapi.yml"
        }
    }
}

apis {
    asyncapi client PaymentsProcessingApi "https://raw.githubusercontent.com/arcadia-editions/payments-processing-api/main/asyncapi.yml"
}

@aggregate
@lifecycle(field: status, initial: RESERVED)
entity StockReservation {
    reservationId String required unique
    orderId String required unique
    sku String required
    quantity Integer required
    status ReservationStatus required
    reservedAt Instant required
    expiresAt Instant required
    releasedAt Instant
    releaseReason StockReleaseReason
}

enum ReservationStatus {
    RESERVED
    RELEASED
    CONFIRMED
}

enum StockReleaseReason {
    PAYMENT_DECLINED
    PAYMENT_RETRY_EXHAUSTED
    PAYMENT_VOIDED
    RESERVATION_EXPIRED
}

input ReserveStockInput {
    orderId String required
    sku String required
    quantity Integer required
}

input ReleaseStockInput {
    reservationId String
    orderId String required
    sku String required
    quantity Integer required
    reason StockReleaseReason required
}

output StockReserved {
    reservationId String
    orderId String
    sku String
    quantity Integer
    reservedAt Instant
    expiresAt Instant
}

output StockUnavailable {
    orderId String
    sku String
    requestedQuantity Integer
    availableQuantity Integer
}

@rest("/inventory")
service InventoryService for (StockReservation) {

    @post("/reservations/reserve")
    @transition(to: RESERVED)
    reserveStock(ReserveStockInput) StockReserved

    @asyncapi(api: PaymentsProcessingApi, channel: "payment-declined-event-v1")
    @asyncapi(api: PaymentsProcessingApi, channel: "payment-retry-exhausted-event-v1")
    @asyncapi(api: PaymentsProcessingApi, channel: "payment-voided-event-v1")
    @timer(api: SchedulerApi, channel: "reservation-expired-event-v1")
    @transition(from: RESERVED, to: RELEASED)
    releaseStock(ReleaseStockInput) StockReservation withEvents StockReleased

    @post("/reservations/confirm")
    @transition(from: RESERVED, to: CONFIRMED)
    confirmStockReservation(ReserveStockInput) withEvents StockReservationConfirmed
}

@asyncapi({ channel: "stock-reserved-event-v1", topic: "catalog-inventory.stock-reserved.event.avro.v1" })
event StockReserved {
    reservationId String
    orderId String
    sku String
    quantity Integer
    reservedAt Instant
    expiresAt Instant
}

@asyncapi({ channel: "stock-released-event-v1", topic: "catalog-inventory.stock-released.event.avro.v1" })
event StockReleased {
    reservationId String
    orderId String
    sku String
    quantity Integer
    reason StockReleaseReason
    releasedAt Instant
}

@asyncapi({ channel: "stock-reservation-confirmed-event-v1", topic: "catalog-inventory.stock-reservation-confirmed.event.avro.v1" })
event StockReservationConfirmed {
    reservationId String
    orderId String
    sku String
    quantity Integer
    reason StockReleaseReason
    releasedAt Instant
}

//--- backoffice ----

@aggregate
entity InventoryPosition {
    sku String required unique
    availableQuantity Integer required
    reservedQuantity Integer required
    soldQuantity Integer required
}


input CreateInventoryPositionInput {
    sku String required
    initialQuantity Integer required
}

input ReceiveStockInput {
    sku String required
    quantity Integer required
    reason String
    reference String
}

input AdjustStockInput {
    sku String required
    quantityDelta Integer required
    reason StockAdjustmentReason required
    reference String
}

enum StockAdjustmentReason {
    DAMAGED
    LOST
    FOUND
    MANUAL_CORRECTION
    RETURNED
}

@rest("/inventory")
service InventoryBackofficeService for (InventoryPosition) {

    @post("/positions")
    createInventoryPosition(CreateInventoryPositionInput) InventoryPosition

    @post("/{sku}/stock-intakes")
    receiveStock(ReceiveStockInput) InventoryPosition withEvents StockReceived

    @post("/{sku}/adjustments")
    adjustStock(AdjustStockInput) InventoryPosition withEvents StockAdjusted
}

@asyncapi({ channel: "stock-received-event-v1", topic: "catalog-inventory.stock-received.event.avro.v1" })
event StockReceived {
    sku String
    quantity Integer
    availableQuantity Integer
    reservedQuantity Integer
    soldQuantity Integer
    reason String
    reference String
    receivedAt Instant
}

@asyncapi({ channel: "stock-adjusted-event-v1", topic: "catalog-inventory.stock-adjusted.event.avro.v1" })
event StockAdjusted {
    sku String
    quantityDelta Integer
    availableQuantity Integer
    reservedQuantity Integer
    soldQuantity Integer
    reason StockAdjustmentReason
    reference String
    adjustedAt Instant
}
